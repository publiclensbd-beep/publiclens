# PublicLens: এই ফাইলটি শুধু নমুনা।
# আসল মান এখানে লিখবেন না। Cloudflare-এর Variables সেটিংসে বসান।
#
# Supabase প্রজেক্ট URL (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
#
# Supabase Publishable key (sb_publishable_... দিয়ে শুরু)
# শুধু Publishable key ব্যবহার করুন।
# secret বা service_role key কখনো এখানে বা সাইটের কোডে দেবেন না।
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
